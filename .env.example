# Application
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=20

# Supabase (publishable/anon is browser-safe; service role is backend-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=sqlite+aiosqlite:///./vet_assistant.db

# AI providers. "disabled" keeps the application operational without secrets.
LLM_PROVIDER=disabled
LLM_MODEL=openrouter/auto
LLM_API_KEY=
VISION_PROVIDER=disabled
VISION_MODEL=
VISION_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=disabled
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
STT_PROVIDER=disabled
STT_MODEL=
STT_API_KEY=
TTS_PROVIDER=browser
TTS_MODEL=
TTS_API_KEY=

# Retrieval
RAG_CANDIDATE_LIMIT=20
RAG_CONTEXT_LIMIT=6
RAG_CHUNK_TOKENS=450
RAG_CHUNK_OVERLAP=60
